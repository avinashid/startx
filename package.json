{
	"name": "startx",
	"description": "",
	"version": "1.1.60",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/avinashid/startx.git"
	},
	"bin": {
		"startx": "./apps/startx-cli/bin/index.mjs"
	},
	"files": [
		"apps/",
		"configs/",
		"packages/",
		"!**/node_modules/",
		"!**/.turbo/",
		"!**/dist/",
		"!**/build/",
		"!**/coverage/",
		"!**/.react-router/",
		"!**/*.tsbuildinfo",
		"!**/.env",
		"!**/.env.*",
		"!**/*.pem",
		"!**/.vercel/",
		"!**/logs/",
		"_gitignore",
		"AGENTS.md",
		".dockerignore",
		".editorconfig",
		".env.example",
		".prettierignore",
		".prettierrc.cjs",
		".prettierrc.mjs",
		"biome.json",
		"eslint.config.ts",
		"pnpm-workspace.yaml",
		"startx.json",
		"turbo.json"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"start": "turbo start",
		"startx": "node ./apps/startx-cli/bin/index.mjs",
		"backend": "turbo dev --filter=core-server -- ",
		"cli": "turbo cli --filter=cli -- ",
		"startx:cli": "turbo cli --filter=startx-cli -- ",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"clean": "turbo clean",
		"test": "turbo test",
		"format": "turbo format",
		"format:check": "turbo format:check",
		"db:push": "turbo run db:push",
		"db:studio": "turbo run db:studio",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:up": "turbo run db:up",
		"db:check": "turbo run db:check",
		"db:pull": "turbo run db:pull"
	},
	"devDependencies": {
		"eslint": "catalog:",
		"vitest": "catalog:",
		"@biomejs/biome": "catalog:",
		"prettier": "catalog:",
		"rimraf": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"tsdown": "catalog:",
		"unrun": "catalog:",
		"tsx": "catalog:",
		"@types/node": "catalog:"
	},
	"dependencies": {
		"zod": "catalog:",
		"@vinejs/vine": "catalog:",
		"axios": "catalog:",
		"date-fns": "catalog:",
		"nanoid": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"startx",
		"turborepo",
		"scaffold",
		"express"
	],
	"author": "avinashid",
	"license": "MIT",
	"packageManager": "pnpm@11.5.1"
}
