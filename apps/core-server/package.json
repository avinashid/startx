{
	"name": "core-server",
	"description": "",
	"version": "1.0.0",
	"type": "module",

	"scripts": {
		"dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
		"dev:debug": "cross-env NODE_ENV=development tsx watch --inspect src/index.ts",
		"bun:dev": "cross-env NODE_ENV=development bun --watch src/index.ts",
		"build": "tsdown --config-loader unrun",
		"start": "node dist/index.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . src/**/*.ts --fix",
		"clean": "rimraf dist .turbo dist",
		"deep:clean": "rimraf node_modules dist .turbo",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome ci .",
		"test": "vitest run"
	},
	"dependencies": {
		"@repo/common": "workspace:^",
		"@db/drizzle": "workspace:^",
		"@repo/mail": "workspace:^",
		"@repo/lib": "workspace:^",
		"@repo/redis": "workspace:^",
		"@repo/env": "workspace:^",
		"@repo/logger": "workspace:^",
		"cookie-parser": "catalog:",
		"cors": "catalog:",
		"country-state-city": "catalog:",
		"express": "catalog:",
		"express-fileupload": "catalog:",
		"express-list-endpoints": "catalog:",
		"express-rate-limit": "catalog:",
		"helmet": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"cross-env": "catalog:",
		"@types/cookie-parser": "catalog:",
		"@types/cors": "catalog:",
		"@types/express": "catalog:",
		"@types/express-fileupload": "catalog:",
		"@types/morgan": "catalog:",
		"eslint-config": "workspace:*",
		"vitest-config": "workspace:*",
		"tsdown-config": "workspace:*",
		"typescript-config": "workspace:*"
	},
	"startx": {
		"gTags": [
			"node",
			"backend"
		],
		"tags": [
			"express"
		],
		"requiredDeps": [
			"@repo/env",
			"@repo/logger",
			"@repo/lib",
			"@repo/common",
			"@repo/redis"
		],
		"requiredDevDeps": [
			"typescript-config",
			"tsdown-config"
		]
	}
}
